{
  "name": "@your-scope/react-hook-form-persist",
  "version": "0.1.0",
  "description": "Type-safe React Hook Form drafts with pluggable asynchronous storage",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "react",
    "react-hook-form",
    "draft",
    "persist",
    "indexeddb",
    "typescript"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./indexed": {
      "types": "./dist/indexed.d.ts",
      "import": "./dist/indexed.js"
    },
    "./custom": {
      "types": "./dist/custom/index.d.ts",
      "import": "./dist/custom/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:package": "node scripts/validate-package.mjs",
    "test:consumer": "node scripts/test-consumer.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run validate:package",
    "prepack": "npm run build"
  },
  "dependencies": {
    "idb": "^8.0.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-hook-form": ">=7.55.0 <8"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hookform/resolvers": "^5.9.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.55.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^3.25.76"
  }
}
